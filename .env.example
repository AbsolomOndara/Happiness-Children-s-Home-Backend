NODE_ENV=development
PORT=4000
# Neon pooled connection string. Keep this secret on the backend only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:5173,https://happinesschildrenshome.co.ke,https://www.happinesschildrenshome.co.ke
# The Vercel /api rewrite keeps admin API calls on the website origin; cookies are host-only and SameSite=Lax.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=happiness-home-gallery
# Copy the public r2.dev URL or active custom domain from Cloudflare. No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-REPLACE_WITH_YOUR_BUCKET_ID.r2.dev
