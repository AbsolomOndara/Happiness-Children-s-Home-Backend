NODE_ENV=development
PORT=4000
# Neon pooled connection string. Keep this secret on the backend only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-VERCEL-DOMAIN.vercel.app
# Use none + Secure for cross-site API cookies. If frontend and API share a registrable domain,
# set COOKIE_SAME_SITE=lax and COOKIE_DOMAIN=.yourdomain.org where appropriate.
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
home-gallery
# Public custom domain or public.dev URL for the R2 bucket, without a trailing slash.
R2_PUBLIC_BASE_URL=https://images.YOUR-DOMAIN
